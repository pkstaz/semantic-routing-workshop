# Demo OpenShift — variables de entorno
#
# Instalación:
#   cp env.demo.example demo.env
#   # Edita solo OPENSHIFT_AI_TOKEN en demo.env
#   ./install.sh

# Namespace donde se despliega el semantic router
DEMO_NAMESPACE=semantic-router-demo

# Endpoints MaaS (ya configurados — no editar salvo que cambien)
LLAMA_SERVICE_URL=https://maas.apps.ocp.cloud.rhai-tmm.dev/prelude-maas/llama-32-3b
QWEN_SERVICE_URL=https://maas.apps.ocp.cloud.rhai-tmm.dev/prelude-maas/qwen25-vl-7b-instruct-fp8
GRANITE_VISION_SERVICE_URL=https://maas.apps.ocp.cloud.rhai-tmm.dev/prelude-maas/granite-vision-32-2b

# Token MaaS — autenticación contra los modelos remotos
OPENSHIFT_AI_TOKEN=your-token-here

# HuggingFace — requerido para descargar modelos de clasificación del router (mmBERT)
# Crear en https://huggingface.co/settings/tokens (debe empezar por hf_, no yhf_)
HF_TOKEN=your-hf-token-here

# Helm
HELM_RELEASE=semantic-router-demo
HELM_CHART=oci://ghcr.io/vllm-project/charts/semantic-router
HELM_CHART_VERSION=

# StorageClass del cluster (gp3-csi en AWS/OpenShift sandbox)
STORAGE_CLASS=gp3-csi
