# Envoy Deployment + Service (ConfigMap se crea en install.sh desde envoy.yaml generado).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${HELM_RELEASE}-envoy
  namespace: ${DEMO_NAMESPACE}
  labels:
    app.kubernetes.io/instance: ${HELM_RELEASE}
    app.kubernetes.io/component: envoy
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/instance: ${HELM_RELEASE}
      app.kubernetes.io/component: envoy
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: ${HELM_RELEASE}
        app.kubernetes.io/component: envoy
    spec:
      containers:
        - name: envoy
          image: docker.io/envoyproxy/envoy:v1.31.2
          # Evitar docker-entrypoint.sh (hace chown de stdout/stderr → falla en OpenShift restricted)
          command:
            - /usr/local/bin/envoy
          args:
            - -c
            - /etc/envoy/envoy.yaml
            - --log-level
            - info
          ports:
            - name: http
              containerPort: 8899
              protocol: TCP
          volumeMounts:
            - name: config
              mountPath: /etc/envoy
              readOnly: true
            - name: logs
              mountPath: /var/log
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
      volumes:
        - name: config
          configMap:
            name: ${HELM_RELEASE}-envoy-config
        - name: logs
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: ${HELM_RELEASE}-envoy
  namespace: ${DEMO_NAMESPACE}
  labels:
    app.kubernetes.io/instance: ${HELM_RELEASE}
    app.kubernetes.io/component: envoy
spec:
  type: ClusterIP
  ports:
    - name: http
      port: 8899
      targetPort: 8899
      protocol: TCP
  selector:
    app.kubernetes.io/instance: ${HELM_RELEASE}
    app.kubernetes.io/component: envoy
