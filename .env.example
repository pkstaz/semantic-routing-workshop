# OpenShift AI — endpoints OpenAI-compatible (sin /v1 al final)
LLAMA_ENDPOINT=https://your-openshift-ai-host/llama-32-3b
QWEN_CODE_ENDPOINT=https://your-openshift-ai-host/qwen35-9b
GRANITE_VISION_ENDPOINT=https://your-openshift-ai-host/granite-vision-32-2b

# Token de autenticación para OpenShift AI
OPENSHIFT_AI_TOKEN=your-openshift-ai-token-here

# Puertos locales (valores por defecto de vllm-sr)
CHAT_API_PORT=8899       # API de chat (Envoy) — Open WebUI apunta aquí
ROUTER_API_PORT=8080     # API interna del router (eval, debugging)
DASHBOARD_PORT=8700
WEBUI_PORT=3000
